<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Compile-time dimensional quantities with generated aliases and arithmetic.</Description>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DimensionalQuantities.Roslyn/DimensionalQuantities.Roslyn.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../DimensionalQuantities.Roslyn/bin/$(Configuration)/netstandard2.0/DimensionalQuantities.Roslyn.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DimensionalQuantities.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Numerics\Rational.Conversions.cs">
      <DependentUpon>Rational.cs</DependentUpon>
    </Compile>
    <Compile Update="Numerics\Rational.Text.cs">
      <DependentUpon>Rational.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
